{
  "name": "mailslurp-client",
  "description": "Official client for MailSlurp Email and SMS API. Create email addresses and phone numbers in Javascript without a mail server. Send and receive real emails in applications or tests.",
  "version": "17.6.0",
  "license": "MIT",
  "author": "mailslurp.com",
  "homepage": "https://www.mailslurp.com",
  "keywords": [
    "email",
    "smtp",
    "test",
    "e2e",
    "phone",
    "sms",
    "ai",
    "integration",
    "account",
    "receive",
    "send",
    "mailslurp"
  ],
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "repository": "https://github.com/mailslurp/mailslurp-client",
  "scripts": {
    "build": "tsc --outDir dist/",
    "prepublishOnly": "npm run build",
    "integration": "npm run build && npm --prefix test run integration --",
    "test:package": "npm run build && node test/package-interop.js",
    "test:runtime": "node test/runtime-smoke.js",
    "validate": "npx check-md",
    "docs": "typedoc --plugin typedoc-plugin-markdown --options ./typedoc.json ./src/index.ts",
    "docs:html": "typedoc --plugin typedoc-plugin-mdn-links --options ./typedoc.html.json ./src/index.ts",
    "docs:lint": "npx check-md --fix --cwd ./docs --preset vuepress",
    "fmt": "oxfmt --write '{src,test}/**/*.{ts,json,js,mjs}'",
    "readme": "node --trace-deprecation --abort-on-uncaught-exception -r ts-node/register scripts/readme.ts",
    "test": "npm run integration",
    "test:install": "npm ci --prefix test",
    "test:typecheck": "npm run build && npm --prefix test run typecheck",
    "fmt:check": "oxfmt --check '{src,test}/**/*.{ts,json,js,mjs}'"
  },
  "dependencies": {
    "cross-fetch": "^4.1.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.2",
    "debug": "^4.3.4",
    "fast-glob": "^3.2.11",
    "markdownlint-cli": "^0.49.1",
    "oxfmt": "^0.70.0",
    "remark": "^14.0.1",
    "remark-cli": "^10.0.0",
    "remark-validate-links": "^11.0.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "~6.0.3"
  },
  "check-md": {
    "cwd": "./docs",
    "defaultIndex": [
      "index.md",
      "README.md"
    ],
    "exitLevel": "warn"
  }
}
